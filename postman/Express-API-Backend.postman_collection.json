  "item": [
    {
      "name": "Auth",
      "description": "POST /api/v1/auth/register and /login. Run 'Register user' then 'Login' first so the other folders have a user id and a token.",
      "item": [
        {
          "name": "Register user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'pm.' + Date.now() + '@example.test';",
                  "pm.collectionVariables.set('registerEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('success is true', function () { pm.expect(body.success).to.be.true; });",
                  "pm.test('created user has no password in response', function () {",
                  "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get('registerEmail'));",
                  "  pm.expect(body.data).to.not.have.property('password');",
                  "  pm.expect(body.data._id).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('userId', body.data._id);",
                  "pm.collectionVariables.set('loginEmail', body.data.email);",
                  "pm.collectionVariables.set('loginPassword', 'Pass1234');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"Pass1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Creates a fresh account. A unique email is generated in the pre-request script. Stores the new id/credentials for the rest of the collection."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('success is true and token is returned', function () {",
                  "  pm.expect(body.success).to.be.true;",
                  "  pm.expect(body.token).to.be.a('string');",
                  "});",
                  "pm.test('login sets an httpOnly accessToken cookie', function () {",
                  "  const raw = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(raw).to.include('accessToken=');",
                  "  pm.expect(raw.toLowerCase()).to.include('httponly');",
                  "});",
                  "pm.collectionVariables.set('authToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Logs in with the user created by 'Register user' and stores the JWT in authToken for the User folder's Bearer auth."
          },
          "response": []
        },
